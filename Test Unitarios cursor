class TestUpdateQuality:
    def test_actualiza_varios_items(self):
        normal = item("foo", 5, 10)
        brie = item(GildedRose.AGED_BRIE, 2, 0)
        sulfuras = item(GildedRose.SULFURAS, 0, 80)
        rose_for(normal, brie, sulfuras).update_quality()
        assert (normal.sell_in, normal.quality) == (4, 9)
        assert (brie.sell_in, brie.quality) == (1, 1)
        assert (sulfuras.sell_in, sulfuras.quality) == (0, 80)

    def test_lista_vacia(self):
        GildedRose([]).update_quality()

    @pytest.mark.parametrize(
        "name, sell_in, quality, expected_sell_in, expected_quality",
        [
            ("+5 Dexterity Vest", 10, 20, 9, 19),
            ("Elixir of the Mongoose", 5, 7, 4, 6),
            ("Elixir of the Mongoose", 0, 7, -1, 5),
            ("Elixir of the Mongoose", 5, 0, 4, 0),
            (GildedRose.AGED_BRIE, 2, 0, 1, 1),
            (GildedRose.AGED_BRIE, 0, 0, -1, 2),
            (GildedRose.AGED_BRIE, 2, 50, 1, 50),
            (GildedRose.SULFURAS, 0, 80, 0, 80),
            (GildedRose.SULFURAS, -1, 80, -1, 80),
            (GildedRose.BACKSTAGE_PASS, 15, 20, 14, 21),
            (GildedRose.BACKSTAGE_PASS, 10, 49, 9, 50),
            (GildedRose.BACKSTAGE_PASS, 5, 49, 4, 50),
            (GildedRose.BACKSTAGE_PASS, 1, 20, 0, 23),
            (GildedRose.BACKSTAGE_PASS, 0, 20, -1, 0),
        ],
    )
    def test_casos_del_kata(
        self, name, sell_in, quality, expected_sell_in, expected_quality
    ):
        inventory_item = item(name, sell_in, quality)
        rose_for(inventory_item).update_quality()
        assert inventory_item.sell_in == expected_sell_in
        assert inventory_item.quality == expected_quality
