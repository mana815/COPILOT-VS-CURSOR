
# -*- coding: utf-8 -*-
"""Tests unitarios de las funciones refactorizadas de GildedRose."""

import pytest

from gilded_rose import GildedRose, Item


def item(name="foo", sell_in=10, quality=20):
    return Item(name, sell_in, quality)


def rose_for(*items):
    return GildedRose(list(items))


class TestItem:
    def test_repr(self):
        assert repr(Item("foo", 5, 10)) == "foo, 5, 10"


class TestIncreaseQuality:
    def test_incrementa_en_uno(self):
        inventory_item = item(quality=20)
        GildedRose([])._increase_quality(inventory_item)
        assert inventory_item.quality == 21

    def test_no_supera_calidad_maxima(self):
        inventory_item = item(quality=GildedRose.MAX_QUALITY)
        GildedRose([])._increase_quality(inventory_item)
        assert inventory_item.quality == GildedRose.MAX_QUALITY

    def test_incrementa_justo_bajo_el_maximo(self):
        inventory_item = item(quality=GildedRose.MAX_QUALITY - 1)
        GildedRose([])._increase_quality(inventory_item)
        assert inventory_item.quality == GildedRose.MAX_QUALITY


class TestDecreaseQuality:
    def test_decrementa_en_uno(self):
        inventory_item = item(quality=20)
        GildedRose([])._decrease_quality(inventory_item)
        assert inventory_item.quality == 19

    def test_no_baja_de_cero(self):
        inventory_item = item(quality=0)
        GildedRose([])._decrease_quality(inventory_item)
        assert inventory_item.quality == 0

    def test_decrementa_calidad_uno(self):
        inventory_item = item(quality=1)
        GildedRose([])._decrease_quality(inventory_item)
        assert inventory_item.quality == 0


class TestUpdateBackstagePass:
    @pytest.mark.parametrize(
        "sell_in, quality, expected",
        [
            (11, 20, 21),
            (10, 20, 22),
            (6, 20, 22),
            (5, 20, 23),
            (1, 20, 23),
            (15, 49, 50),
            (10, 49, 50),
            (5, 48, 50),
        ],
    )
    def test_incremento_segun_dias(self, sell_in, quality, expected):
        inventory_item = item(GildedRose.BACKSTAGE_PASS, sell_in, quality)
        GildedRose([])._update_backstage_pass(inventory_item)
        assert inventory_item.quality == expected
        assert inventory_item.sell_in == sell_in


class TestUpdateExpiredItem:
    def test_backstage_pasa_a_cero(self):
        inventory_item = item(GildedRose.BACKSTAGE_PASS, -1, 40)
        GildedRose([])._update_expired_item(inventory_item)
        assert inventory_item.quality == 0

    def test_aged_brie_aumenta_calidad(self):
        inventory_item = item(GildedRose.AGED_BRIE, -1, 20)
        GildedRose([])._update_expired_item(inventory_item)
        assert inventory_item.quality == 21

    def test_aged_brie_respeta_maximo(self):
        inventory_item = item(GildedRose.AGED_BRIE, -1, 50)
        GildedRose([])._update_expired_item(inventory_item)
        assert inventory_item.quality == 50

    def test_item_normal_baja_calidad(self):
        inventory_item = item("Elixir of the Mongoose", -1, 10)
        GildedRose([])._update_expired_item(inventory_item)
        assert inventory_item.quality == 9

    def test_item_normal_no_baja_de_cero(self):
        inventory_item = item("Elixir of the Mongoose", -1, 0)
        GildedRose([])._update_expired_item(inventory_item)
        assert inventory_item.quality == 0


class TestUpdateItem:
