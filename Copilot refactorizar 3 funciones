# -*- coding: utf-8 -*-

class GildedRose(object):

    AGED_BRIE = "Aged Brie"
    BACKSTAGE_PASS = "Backstage passes to a TAFKAL80ETC concert"
    SULFURAS = "Sulfuras, Hand of Ragnaros"
    MAX_QUALITY = 50

    def __init__(self, items):
        self.items = items

    def update_quality(self):
        for inventory_item in self.items:
            self._update_item(inventory_item)

    def _update_item(self, inventory_item):
        if inventory_item.name == self.SULFURAS:
            return

        if inventory_item.name == self.AGED_BRIE:
            self._increase_quality(inventory_item)
        elif inventory_item.name == self.BACKSTAGE_PASS:
            self._update_backstage_pass(inventory_item)
        else:
            self._decrease_quality(inventory_item)

        inventory_item.sell_in -= 1

        if inventory_item.sell_in < 0:
            self._update_expired_item(inventory_item)

    def _update_backstage_pass(self, inventory_item):
        self._increase_quality(inventory_item)

        if inventory_item.sell_in < 11:
            self._increase_quality(inventory_item)
        if inventory_item.sell_in < 6:
            self._increase_quality(inventory_item)

    def _update_expired_item(self, inventory_item):
        if inventory_item.name == self.BACKSTAGE_PASS:
            inventory_item.quality = 0
        elif inventory_item.name == self.AGED_BRIE:
            self._increase_quality(inventory_item)
        else:
            self._decrease_quality(inventory_item)

    def _increase_quality(self, inventory_item):
        if inventory_item.quality < self.MAX_QUALITY:
            inventory_item.quality += 1

    def _decrease_quality(self, inventory_item):
        if inventory_item.quality > 0:
            inventory_item.quality -= 1


class Item:
    def __init__(self, name, sell_in, quality):
        self.name = name
        self.sell_in = sell_in
        self.quality = quality

    def __repr__(self):
        return "%s, %s, %s" % (self.name, self.sell_in, self.quality)

